{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../node_modules/ultracite/config/oxlint/core/.oxlintrc.json",
    "../node_modules/ultracite/config/oxlint/react/.oxlintrc.json",
    "../node_modules/ultracite/config/oxlint/next/.oxlintrc.json"
  ],
  "ignorePatterns": ["components/ui/**", ".next/**", "types/api.d.ts"],
  "rules": {
    "sort-keys": "off",
    "func-style": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "import/consistent-type-specifier-style": "off",
    "no-useless-escape": "off",
    "eslint-plugin-unicorn/prefer-string-raw": "off",
    "no-bitwise": "off",
    "max-statements": "off",
    "typescript/consistent-type-definitions": ["error", "interface"],
    "import/order": [
      "error",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index",
          "object",
          "type"
        ],
        "pathGroups": [
          {
            "pattern": "react",
            "group": "external",
            "position": "before"
          },
          {
            "pattern": "react-dom",
            "group": "external",
            "position": "before"
          },
          {
            "pattern": "next/**",
            "group": "external",
            "position": "before"
          }
        ],
        "pathGroupsExcludedImportTypes": ["react", "react-dom", "next"],
        "newlines-between": "always",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        }
      }
    ]
  }
}
